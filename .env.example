# Optional. Leave empty to use the free local parser (recommended for demos).
# The orchestrator never requires a paid model.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Hunyuan 3D — keep OFF unless you are not on stage and have credits left.
# Hard cap is 20 generations. Cached results are reused. Never regenerates in demo mode.
HUNYUAN_ENABLED=0
HUNYUAN_API_KEY=
HUNYUAN_API_URL=
HUNYUAN_MAX_GENERATIONS=20

# Unity Editor path. If missing, the orchestrator packs the HTML5 player instead.
UNITY_EDITOR_PATH=
UNITY_PROJECT_PATH=
UNITY_BUILD_TARGET=WebGL
UNITY_BUILD_LIVE=0

# Delivery: web (HTML5 / later Unity WebGL) or native
DELIVERY_TARGET=web

HOST=127.0.0.1
PORT=8787
